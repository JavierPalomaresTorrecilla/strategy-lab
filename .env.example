# strategy-lab environment template
#
# This file is a template only. It must never contain real credentials.
# Copy it to `.env` (already gitignored) and fill in values locally.
#
# At the current project phase there are NO external integrations
# (no exchange, broker, or data-vendor connectivity). This file exists
# to establish the pattern for when such integrations are introduced.

# General
STRATEGY_LAB_ENV=research   # research | validation (no "live" mode exists yet)

