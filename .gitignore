# --- Data: keep directory structure, ignore actual datasets ---
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/README.md

# --- Reports generated from experiment runs ---
reports/generated/
reports/*.html
reports/*.png
!reports/README.md

# --- Misc local scratch ---
*.log
tmp/
.local/
